---
// The home page's demo: a few scenarios, each as its Thymeleaf source (the shaded half) beside what the library
// rendered from it (the lit half), the two halves of the logo's leaf. The buttons switch scenario, the select skin.
import {Code} from '@astrojs/starlight/components';
import ComponentPreview from './ComponentPreview.astro';
import Missing from './Missing.astro';
import {previews} from '../lib/generated';

const skins = previews.skins.map(skin => skin.name);
const capitalize = (name: string) => name.charAt(0).toUpperCase() + name.slice(1);

const choices = [
  {id: 'card--default', label: 'Card'},
  {id: 'field--default', label: 'Form field'},
  {id: 'table--default', label: 'Table'},
  {id: 'dialog--default', label: 'Dialog'},
].flatMap(choice => {
  const scenario = previews.scenarios.find(s => s.id === choice.id);
  return scenario ? [{...choice, source: scenario.source}] : [];
});
---

{choices.length === 0 ? <Missing what="previews for the home page"/> : (
  <div class="home-demo">
    <div class="home-demo__toolbar">
      <div class="home-demo__choices" role="group" aria-label="Example">
        {choices.map((choice, i) => (
          <button type="button" data-demo={choice.id} aria-pressed={i === 0 ? 'true' : 'false'}>{choice.label}</button>
        ))}
      </div>
      {skins.length > 1 && (
        <label class="home-demo__skin">
          <span>Skin</span>
          <select class="home-demo__skins">
            {skins.map((skin, i) => <option value={skin} selected={i === 0}>{capitalize(skin)}</option>)}
          </select>
        </label>
      )}
    </div>
    {choices.map((choice, i) => (
      <div class="home-demo__pair" data-demo={choice.id} hidden={i !== 0}>
        <div class="home-demo__source">
          <p class="home-demo__caption">You write</p>
          <Code code={choice.source} lang="html" wrap/>
        </div>
        <div class="home-demo__render">
          <p class="home-demo__caption">Your users get</p>
          <ComponentPreview id={choice.id} bare skin={skins[0]}/>
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .home-demo__toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-block-end: 0.75rem;
  }

  .home-demo__skin {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);

    /* The chevron, drawn with borders: the native one differs per browser and ignores the font size. */
    &::after {
      content: '';
      pointer-events: none;
      position: absolute;
      inset-inline-end: 0.875rem;
      top: 50%;
      width: 0.375rem;
      height: 0.375rem;
      border-inline-end: 1.5px solid currentColor;
      border-block-end: 1.5px solid currentColor;
      transform: translateY(-70%) rotate(45deg);
    }
  }

  .home-demo__skins {
    appearance: none;
    margin: 0;
    padding: 0.25rem 2.25rem 0.25rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;

    &:hover {
      border-color: var(--sl-color-gray-4);
    }

    &:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }
  }

  .home-demo__choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;

    & button {
      margin: 0;
      padding: 0.25rem 0.75rem;
      border: 1px solid transparent;
      border-radius: 999px;
      background: transparent;
      color: var(--sl-color-gray-3);
      font: inherit;
      font-size: var(--sl-text-sm);
      cursor: pointer;
    }

    & button:hover {
      color: var(--sl-color-white);
    }

    & button[aria-pressed='true'] {
      border-color: var(--sl-color-gray-5);
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    & button:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }
  }

  .home-demo__pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .home-demo__pair[hidden] {
    display: none;
  }

  @media (min-width: 60rem) {
    .home-demo__pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .home-demo__source {
    min-width: 0;
    background: var(--home-shade);

    & :global(.expressive-code) {
      margin: 0;
    }

    & :global(.expressive-code .frame) {
      box-shadow: none;
    }

    & :global(.expressive-code pre) {
      border: 0;
      background: transparent;
    }
  }

  .home-demo__render {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--sl-color-gray-5);

    & :global(.sl-docs-preview) {
      flex: 1;
      display: grid;
      align-content: center;
    }
  }

  @media (min-width: 60rem) {
    .home-demo__render {
      border-block-start: 0;
      border-inline-start: 1px solid var(--sl-color-gray-5);
    }
  }

  .home-demo__caption {
    margin: 0;
    padding: 0.75rem 1rem 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.home-demo').forEach(demo => {
    // The skin applies to the demo's previews only, and is not remembered: the docs pages keep their own choice.
    demo.querySelector<HTMLSelectElement>('select.home-demo__skins')?.addEventListener('change', event => {
      const skin = (event.target as HTMLSelectElement).value;
      demo.querySelectorAll<HTMLElement>('.sl-docs-preview').forEach(figure => {
        figure.dataset.skin = skin;
      });
      document.dispatchEvent(new Event('sl-docs-preview-skin'));
    });

    const buttons = demo.querySelectorAll<HTMLButtonElement>('button[data-demo]');
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
        demo.querySelectorAll<HTMLElement>('.home-demo__pair').forEach(pair => {
          pair.hidden = pair.dataset.demo !== button.dataset.demo;
        });
      });
    });
  });
</script>
