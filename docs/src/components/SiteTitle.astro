---
// Replaces Starlight's SiteTitle: the logo (a leaf split along its midrib, one half in light, one in shade) and the
// wordmark "shadleaf", set as text so it needs no image per theme. The leaf's colours follow the theme through CSS.
import '@fontsource/schibsted-grotesk/latin-400.css';
import '@fontsource/schibsted-grotesk/latin-800.css';

const {siteTitleHref} = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" translate="no">
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
    <path class="lit" d="M5 27C5 14 14 5 27 5Z"/>
    <path class="shade" d="M5 27L27 5C27 18 18 27 5 27Z"/>
    <path class="stem" d="M5.5 26.5L2.5 29.5"/>
  </svg>
  <span class="word"><span class="shad">shad</span><span class="leaf">leaf</span></span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .mark {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
  }
  .lit {
    fill: var(--sl-color-accent);
  }
  .stem {
    stroke: var(--sl-color-accent);
    stroke-width: 2.25;
    stroke-linecap: round;
  }
  .shade {
    fill: var(--shadleaf-leaf-shade);
  }
  .word {
    font-family: 'Schibsted Grotesk', var(--sl-font);
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .shad {
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
  .leaf {
    font-weight: 800;
  }
</style>
