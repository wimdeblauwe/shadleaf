---
// A live preview of one scenario from previews.json: the markup the library rendered for it, in an iframe that links
// the library's own CSS bundle, with the Thymeleaf source and the rendered HTML underneath.
//
// The iframe is the isolation boundary: the component CSS and Starlight's never see each other. Its document is a
// srcdoc, so it is same-origin: the page swaps the skin stylesheet and the .dark class inside it directly. The skin
// switch applies to every preview and is remembered; light and dark follow the site's theme.
//
// A layout (scenario.layout) is a whole page: no stage around it, the layout's own application CSS, and a frame of a
// fixed size, as wide as a desktop (scaled down to the column) or a phone (the Desktop/Phone switch). Its source is on
// the page as a whole file (LayoutCode.astro), so the preview shows only the rendered HTML.
//
// Starlight's Code (Expressive Code), not astro:components': Starlight turns off Astro's own Shiki highlighting.
import {Code} from '@astrojs/starlight/components';
import Missing from './Missing.astro';
import {previews, withBase} from '../lib/generated';

interface Props {
  /** Scenario id, e.g. "button--variants". */
  id: string;
  /** Only the rendered component: no title bar (skin and width switches) and no source underneath. */
  bare?: boolean;
  /** A skin for this preview alone, instead of the one chosen for the whole site. */
  skin?: string;
}

const {id, bare = false, skin} = Astro.props;
const scenario = previews.scenarios.find(s => s.id === id);
const skins = previews.skins.map(skin => ({name: skin.name, href: withBase(skin.css)}));
const capitalize = (name: string) => name.charAt(0).toUpperCase() + name.slice(1);
// The bundled script, as an application with the default shadleaf.assets.alpine loads it: interactive components work.
const script = previews.scripts?.bundled ? `<script type="module" src="${withBase(previews.scripts.bundled)}"></script>` : '';

// Keeps the preview inert: it has nowhere to navigate to, and a blanked frame looks like a broken component.
const navigationGuard = `<script>
  document.addEventListener('click', event => {
    if (event.target.closest('a[href], button[type="submit"], input[type="submit"]')) event.preventDefault();
  });
  document.addEventListener('submit', event => event.preventDefault());
</script>`;

// The frame reports its height; the page sizes it (see the script below), so no preview gets a scrollbar. It measures
// the body: the root's scrollHeight is never less than the frame's own height, so a frame could grow but not shrink.
const resize = `<script>
  const post = () => parent.postMessage(
      {shadleafPreviewHeight: Math.ceil(document.body.getBoundingClientRect().height)}, '*');
  addEventListener('load', post);
  new ResizeObserver(post).observe(document.body);
</script>`;

// What stands in for a page's content in a layout's preview: shadcn/ui's grey boxes, from the layout YAML's page.
const placeholders = `
    .placeholder-grid { display: grid; gap: 1rem; margin-block-end: 1rem; }
    @media (width >= 48rem) { .placeholder-grid { grid-template-columns: repeat(3, 1fr); } }
    .placeholder { aspect-ratio: 16 / 9; border-radius: 0.75rem; background: color-mix(in oklch, var(--muted) 50%, transparent); }
    .placeholder-tall { aspect-ratio: auto; min-block-size: 40rem; }`;

const layoutSrcdoc = scenario?.layout && skins.length > 0
    ? `<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" id="shadleaf-skin" href="${skins[0].href}">
  <style>${placeholders}</style>
  <style>
${scenario.css ?? ''}
  </style>
</head>
<body>
${scenario.html}
${script}
${navigationGuard}
</body>
</html>`
    : '';

const srcdoc = scenario?.layout ? layoutSrcdoc : scenario && skins.length > 0
    ? `<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" id="shadleaf-skin" href="${skins[0].href}">
  ${bare ? '<style>html, body { background: transparent; } .stage { justify-content: center; }</style>' : ''}
  <style>
    html, body { margin: 0; }
    body { padding: 1.5rem; }
    .stage { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
    /* A card fills its container; give it a width, as a page's layout would. */
    .stage > .card { inline-size: 24rem; max-inline-size: 100%; }
    /* An accordion fills its container, tabs and a collapsible fit their content: give them a width too. */
    .stage > .accordion { max-inline-size: 32rem; }
    .stage > :is(.tabs, .collapsible) { inline-size: 24rem; max-inline-size: 100%; }
    /* A chart is as wide as its container, which a flex item is not: it takes the frame's width. */
    .stage > .chart { inline-size: 100%; }
    /* An application shell is as tall as the screen, which in a frame sized to its content would grow without end. */
    .stage > .sidebar-provider { min-block-size: 20rem; }
    .stage > .sidebar-provider > .sidebar { block-size: auto; align-self: stretch; }
    /* A modal dialog is laid out in the frame's viewport: make room for it while one is open. */
    body:has(dialog:modal) { min-block-size: 32rem; }
    /* So is an open menu or popover, below its trigger. A tooltip shows above its trigger: leave room for it. */
    body:has(:is(.dropdown-menu-content, .popover-content):popover-open) { min-block-size: 28rem; }
    /* And an open select's or combobox's list: the customizable select's picker, or the list box of slSelect (where
       the browser has none) or slCombobox. Two rules: a browser that does not know :open would drop a rule that names
       it. */
    body:has(:is(.select-content, .combobox-content):popover-open) { min-block-size: 28rem; }
    body:has(select:open) { min-block-size: 28rem; }
    /* Toasts are fixed to a corner of the frame: make room for a stack of them while there are any. */
    body:has(.toaster-list > .toast) { min-block-size: 16rem; }
    body:has(.tooltip) { padding-block: 3rem; }
    /* Centred, so a tooltip or popover has room on every side of its trigger and flips only where the docs say so. */
    .stage:has(.tooltip, .popover-content) { justify-content: center; }
  </style>
</head>
<body>
<div class="stage">
${scenario.html}
</div>
${script}
${navigationGuard}
${resize}
</body>
</html>`
    : '';
---

{
  scenario && skins.length > 0 ? (
    <figure class:list={['sl-docs-preview', {'sl-docs-preview--bare': bare}]} data-skins={JSON.stringify(skins)}
            data-skin={skin}>
      {!bare && <div class="sl-docs-preview__bar">
        <figcaption>
          {scenario.title && <strong>{scenario.title}</strong>}
          {scenario.description && <span>{scenario.description}</span>}
        </figcaption>
        {scenario.layout && (
          <div class="sl-docs-preview__widths" role="group" aria-label="Width">
            <button type="button" data-width="desktop" aria-pressed="true">Desktop</button>
            <button type="button" data-width="phone" aria-pressed="false">Phone</button>
          </div>
        )}
        {skins.length > 1 && (
          <label class="sl-docs-preview__skin">
            <span>Skin</span>
            <select class="sl-docs-preview__skins">
              {skins.map((skin, i) => <option value={skin.name} selected={i === 0}>{capitalize(skin.name)}</option>)}
            </select>
          </label>
        )}
      </div>}
      {scenario.layout ? (
        <div class="sl-docs-preview__stage sl-docs-preview__viewport" data-mode="desktop">
          <iframe class="sl-docs-preview__frame sl-docs-preview__page" loading="lazy"
                  title={`Preview: ${scenario.title ?? id}`} srcdoc={srcdoc}></iframe>
        </div>
      ) : (
        <div class="sl-docs-preview__stage">
          <iframe class="sl-docs-preview__frame" loading="lazy" title={`Preview: ${scenario.title ?? id}`} srcdoc={srcdoc}
                  style={scenario.width ? `max-width: ${scenario.width}px` : undefined}
                  data-width={scenario.width ?? undefined}></iframe>
        </div>
      )}
      {!bare && !scenario.layout && (
        <details class="sl-docs-preview__code">
          <summary>Thymeleaf source</summary>
          <Code code={scenario.source} lang="html"/>
        </details>
      )}
      {!bare && (
        <details class="sl-docs-preview__code">
          <summary>Rendered HTML</summary>
          <Code code={scenario.normalizedHtml} lang="html"/>
        </details>
      )}
    </figure>
  ) : (
    <Missing what={`preview for ${id}`}/>
  )
}

<style>
  .sl-docs-preview {
    margin: 1.5rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .sl-docs-preview--bare {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .sl-docs-preview__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);

    & figcaption {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
      color: var(--sl-color-gray-2);
    }
  }

  /* One select for the skins: a group of buttons would not fit the bar once there are more than a few. */
  .sl-docs-preview__skin {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--sl-color-gray-3);

    /* The chevron, drawn with borders: the native one differs per browser and ignores the font size. */
    &::after {
      content: '';
      pointer-events: none;
      position: absolute;
      inset-inline-end: 0.75rem;
      top: 50%;
      width: 0.375rem;
      height: 0.375rem;
      border-inline-end: 1.5px solid currentColor;
      border-block-end: 1.5px solid currentColor;
      transform: translateY(-70%) rotate(45deg);
      color: var(--sl-color-gray-3);
    }
  }

  .sl-docs-preview__skins {
    appearance: none;
    margin: 0;
    padding: 0.125rem 2rem 0.125rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    cursor: pointer;

    &:hover {
      border-color: var(--sl-color-gray-4);
    }

    &:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }
  }

  .sl-docs-preview__widths {
    display: flex;
    gap: 0.25rem;
    margin: 0;

    & button {
      margin: 0;
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.25rem;
      background: transparent;
      color: var(--sl-color-gray-2);
      font: inherit;
      cursor: pointer;
    }

    & button[aria-pressed='true'] {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
      border-color: var(--sl-color-gray-4);
    }
  }

  .sl-docs-preview__stage {
    margin: 0;
  }

  .sl-docs-preview__frame {
    display: block;
    width: 100%;
    margin-inline: auto;
    height: 5.5rem;
    border: 0;
  }

  /* A frame as narrow as a phone, outlined so its edges show where the page's column goes on. */
  .sl-docs-preview__frame[data-width] {
    border-inline: 1px dashed var(--sl-color-gray-5);
  }

  /*
    A layout's page: 1280 x 800 CSS pixels (a desktop, past the sidebar's 768 px breakpoint) scaled down to the column
    by the script below, which also sets the viewport's height; or a phone's 390 x 760, as it is.
  */
  .sl-docs-preview__viewport {
    overflow: hidden;
  }

  .sl-docs-preview__page {
    transform-origin: 0 0;
  }

  .sl-docs-preview__viewport[data-mode='desktop'] .sl-docs-preview__page {
    width: 1280px;
    max-width: none;
    height: 800px;
  }

  .sl-docs-preview__viewport[data-mode='phone'] .sl-docs-preview__page {
    width: 390px;
    max-width: 100%;
    height: 760px;
    border-inline: 1px dashed var(--sl-color-gray-5);
  }

  .sl-docs-preview__code {
    margin: 0;
    border-top: 1px solid var(--sl-color-gray-5);

    & summary {
      padding: 0.5rem 0.75rem;
      font-size: var(--sl-text-sm);
      cursor: pointer;
      user-select: none;
    }

    & :global(.expressive-code) {
      margin: 0;
      padding: 0 0.75rem 0.75rem;
    }
  }
</style>

<script>
  const SKIN_KEY = 'shadleaf-docs-skin';

  type SkinLink = { name: string; href: string };

  function storedSkin(): string | null {
    try {
      return localStorage.getItem(SKIN_KEY);
    } catch {
      return null;
    }
  }

  function apply(figure: HTMLElement) {
    const skins: SkinLink[] = JSON.parse(figure.dataset.skins ?? '[]');
    // A figure's own data-skin (the home page's demo) wins over the docs-wide choice.
    const skin = skins.find(s => s.name === (figure.dataset.skin ?? storedSkin())) ?? skins[0];
    const select = figure.querySelector<HTMLSelectElement>('select.sl-docs-preview__skins');
    if (select && skin) {
      select.value = skin.name;
    }
    const doc = figure.querySelector('iframe')?.contentDocument;
    const link = doc?.getElementById('shadleaf-skin') as HTMLLinkElement | null;
    if (!doc || !link || !skin) {
      return; // not loaded yet; the load listener applies it
    }
    if (link.getAttribute('href') !== skin.href) {
      link.setAttribute('href', skin.href);
    }
    doc.documentElement.classList.toggle('dark', document.documentElement.dataset.theme === 'dark');
  }

  const figures = () => document.querySelectorAll<HTMLElement>('.sl-docs-preview');

  // Sent by a page that changed a figure's data-skin.
  document.addEventListener('sl-docs-preview-skin', () => figures().forEach(apply));

  figures().forEach(figure => {
    figure.querySelector('iframe')?.addEventListener('load', () => apply(figure));
    apply(figure);
    figure.querySelector<HTMLSelectElement>('select.sl-docs-preview__skins')?.addEventListener('change', event => {
      try {
        localStorage.setItem(SKIN_KEY, (event.target as HTMLSelectElement).value);
      } catch {
        // the choice then lasts for this page only
      }
      figures().forEach(apply);
    });
  });

  // A layout's frame: a desktop scaled to the column, or a phone as it is.
  const DESKTOP = {width: 1280, height: 800};

  function fit(viewport: HTMLElement) {
    const frame = viewport.querySelector<HTMLIFrameElement>('iframe');
    if (!frame) {
      return;
    }
    if (viewport.dataset.mode === 'phone') {
      frame.style.transform = '';
      viewport.style.height = '';
      return;
    }
    const scale = Math.min(1, viewport.clientWidth / DESKTOP.width);
    frame.style.transform = `scale(${scale})`;
    viewport.style.height = `${Math.ceil(DESKTOP.height * scale)}px`;
  }

  document.querySelectorAll<HTMLElement>('.sl-docs-preview__viewport').forEach(viewport => {
    new ResizeObserver(() => fit(viewport)).observe(viewport);
    const figure = viewport.closest('.sl-docs-preview')!;
    figure.querySelectorAll<HTMLButtonElement>('button[data-width]').forEach(button => {
      button.addEventListener('click', () => {
        viewport.dataset.mode = button.dataset.width;
        figure.querySelectorAll<HTMLButtonElement>('button[data-width]').forEach(other =>
            other.setAttribute('aria-pressed', String(other === button)));
        fit(viewport);
      });
    });
  });

  // Starlight's theme picker sets data-theme on <html>.
  new MutationObserver(() => figures().forEach(apply))
      .observe(document.documentElement, {attributes: true, attributeFilter: ['data-theme']});

  // A frame that loaded before this (deferred) script ran posted its height to no one: measure it here, which the
  // srcdoc frames allow as they are same-origin. Layout frames have a fixed size.
  document.querySelectorAll<HTMLIFrameElement>('.sl-docs-preview__frame:not(.sl-docs-preview__page)').forEach(frame => {
    const doc = frame.contentDocument;
    if (doc?.URL === 'about:srcdoc' && doc.readyState === 'complete') {
      frame.style.height = `${Math.ceil(doc.body.getBoundingClientRect().height)}px`;
    }
  });

  addEventListener('message', event => {
    const height = (event.data as { shadleafPreviewHeight?: number })?.shadleafPreviewHeight;
    if (typeof height !== 'number') {
      return;
    }
    document.querySelectorAll<HTMLIFrameElement>('.sl-docs-preview__frame').forEach(frame => {
      if (frame.contentWindow === event.source) {
        frame.style.height = `${height}px`;
      }
    });
  });
</script>
