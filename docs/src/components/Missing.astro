---
// Shown instead of generated content when the library has not been built yet.
import {GENERATE_COMMAND} from '../lib/generated';

interface Props {
  what: string;
}

const {what} = Astro.props;
---

<aside class="sl-docs-missing">
  <p>
    No {what} yet. Run <code>{GENERATE_COMMAND}</code> in <code>docs/</code> (or <code>mvn install</code> in the
    repository root) and reload.
  </p>
</aside>

<style>
  .sl-docs-missing {
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.5rem;
  }
</style>
