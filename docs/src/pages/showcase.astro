---
// Every preview scenario on one bare page, with nothing but the library's own CSS: what axe-core and the keyboard
// focus pass run against (tests/). No Starlight chrome and no iframes, so every finding is the library's. It loads the
// bundled script, as an application with the default shadleaf.assets.alpine does, so interactive components work.
//
//   showcase/?skin=lyra&theme=dark    skin: a skin name (default: the first); theme: light (default) or dark
//
// The header layout, a second application shell, is on showcase/header/ (a page holds one main).
import ShowcaseHead from '../components/ShowcaseHead.astro';
import {previews} from '../lib/generated';

// A scenario can stay off the showcase (showcase: false): a toast shown at load would get in other tests' way.
const scenarios = previews.scenarios.filter(s => s.showcase !== false);
// An application shell (sl:sidebar-provider) holds the page's <main> and navigation, which cannot sit inside another
// landmark. So the other scenarios go in a labelled region (axe wants all content in a landmark), and a shell scenario
// comes first, at the top level, as a page's shell would be; its headings stay in the region. First, so its skip link is
// the page's first link: axe only takes a link for a skip link (outside any landmark) before the page's other links. A
// page has one main, so only one shell scenario may be on the showcase.
const isShell = (scenario: {html: string}) => scenario.html.includes('class="sidebar-provider"');
const shells = scenarios.filter(isShell);
if (shells.length > 1) {
  throw new Error(`Only one application shell fits on the showcase; set showcase: false on all but one of ${
      shells.map(s => s.id).join(', ')}`);
}
const components = [...new Set(scenarios.map(s => s.component))];
---

<!doctype html>
<html lang="en">
<head>
  <ShowcaseHead title="Shadleaf showcase"/>
  <style>
    body { padding: 2rem; font-family: system-ui, sans-serif; }
    h1 { font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem; }
    h2 { font-size: 1.25rem; font-weight: 600; margin: 2rem 0 1rem; }
    h3 { font-size: 0.875rem; font-weight: 500; margin: 1.25rem 0 0.5rem; }
    .stage { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
    /* A card fills its container; give it a width, as a page's layout would. */
    .stage > :global(.card) { inline-size: 24rem; max-inline-size: 100%; }
    /* An accordion fills its container, tabs and a collapsible fit their content: give them a width too. */
    .stage > :global(.accordion) { max-inline-size: 32rem; }
    .stage > :global(:is(.tabs, .collapsible)) { inline-size: 24rem; max-inline-size: 100%; }
    /* An application shell is as tall as the screen; on the showcase, as tall as a few links need. */
    .stage > :global(.sidebar-provider) { min-block-size: 24rem; }
    .stage > :global(.sidebar-provider > .sidebar) { block-size: auto; align-self: stretch; }
  </style>
</head>
<body>
{shells.map(scenario => <div class="showcase stage" data-scenario={scenario.id} set:html={scenario.html}/>)}
<div class="showcase" role="region" aria-label="Showcase">
  <h1>Shadleaf showcase</h1>
  {previews.scenarios.length === 0 && <p>No previews: run <code>pnpm run generate</code> in docs/.</p>}
  {components.map(component => (
    <section>
      <h2>{component}</h2>
      {scenarios.filter(s => s.component === component).map(scenario => (
        <>
          <h3>{scenario.title ?? scenario.id}</h3>
          {!isShell(scenario) && <div class="stage" data-scenario={scenario.id} set:html={scenario.html}/>}
        </>
      ))}
    </section>
  ))}
</div>
</body>
</html>
