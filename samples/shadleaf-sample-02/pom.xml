<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
    <!-- lookup parent from repository -->
  </parent>
  <groupId>io.github.wimdeblauwe.shadleaf.samples</groupId>
  <artifactId>shadleaf-sample-02</artifactId>
  <version>0.8.0-SNAPSHOT</version>
  <name>Shadleaf Sample App 2</name>
  <description>
    Shadleaf behind Spring Security with a strict Content-Security-Policy, and no Node in the build.
    Run `mvn install` in the repository root first.
  </description>

  <properties>
    <java.version>17</java.version>
    <shadleaf.version>0.8.0-SNAPSHOT</shadleaf.version>
    <!-- HxRedirectToPage* (an htmx request after the session expired) are new in 5.2.0 -->
    <htmx-spring-boot.version>5.2.0</htmx-spring-boot.version>
    <!-- htmx itself, pinned: the webjar is served from the application's own origin (/webjars/**), which the strict
      policy's script-src 'self' allows -->
    <htmx.version>2.0.11</htmx.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- sec:authorize in the templates (navigation by role); Spring Boot manages its version and configures it -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.wimdeblauwe</groupId>
      <artifactId>shadleaf-spring-boot-starter</artifactId>
      <version>${shadleaf.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.wimdeblauwe</groupId>
      <artifactId>htmx-spring-boot</artifactId>
      <version>${htmx-spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>htmx.org</artifactId>
      <version>${htmx.version}</version>
    </dependency>
    <dependency>
      <!-- Lets templates leave the version out of /webjars/ URLs; the pom above is the only place it is written. -->
      <groupId>org.webjars</groupId>
      <artifactId>webjars-locator-lite</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.22.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
