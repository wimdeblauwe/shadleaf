<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.wimdeblauwe</groupId>
    <artifactId>shadleaf-parent</artifactId>
    <version>0.7.0</version>
  </parent>

  <artifactId>shadleaf-spring-boot-starter</artifactId>
  <name>Shadleaf Spring Boot Starter</name>
  <description>shadcn/ui for Thymeleaf: components, theming and pre-compiled CSS for Spring Boot applications.</description>

  <properties>
    <!-- JUnit tags: the performance profile swaps them -->
    <shadleaf.test.groups/>
    <shadleaf.test.excluded-groups>performance,without-spring-security</shadleaf.test.excluded-groups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- sl:table and sl:pagination read a Page or Slice when the application has Spring Data; without it they take
      their state from the request -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-commons</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- #slUser reads the signed-in user when the application has Spring Security; without it nobody is signed in.
      OAuth2 client: the claims of an OpenID Connect or OAuth2 login, and the sign-in URL of a single client -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-client</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ComponentRenderTester renders in a mock web exchange, so @{/...} links work -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ComponentRenderTester sets up Spring MVC's RequestContext, which th:field and #fields read the binding from -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- oidcLogin(), oauth2Login(), user() for ComponentRenderTester.Builder.with() -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <!-- Vite builds these into META-INF/resources/shadleaf; the sources must not end up in the jar -->
          <exclude>static/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-autoconfigure-processor</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install-node-and-pnpm</id>
            <goals>
              <goal>install-node-and-pnpm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <nodeVersion>${frontend-maven-plugin.nodeVersion}</nodeVersion>
              <pnpmVersion>${frontend-maven-plugin.pnpmVersion}</pnpmVersion>
            </configuration>
          </execution>
          <execution>
            <id>pnpm-install</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>
          <execution>
            <id>pnpm-build</id>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- RenderPerformanceTest runs only with -Pperformance -->
          <excludedGroups>${shadleaf.test.excluded-groups}</excludedGroups>
          <groups>${shadleaf.test.groups}</groups>
          <systemPropertyVariables>
            <!-- PreviewGeneratorTest stamps the docs artifacts with it -->
            <shadleaf.version>${project.version}</shadleaf.version>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <!-- WithoutSpringSecurityTest alone (the other test classes name Spring Security types, which fails their
            discovery), on a classpath without Spring Security: the starter must start and render in an application that
            does not have it. Set here, so -Dtest on the command line does not change it. -->
          <execution>
            <id>without-spring-security</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <test>WithoutSpringSecurityTest</test>
              <groups>without-spring-security</groups>
              <excludedGroups>performance</excludedGroups>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.springframework.security:spring-security-core</classpathDependencyExclude>
                <classpathDependencyExclude>org.springframework.security:spring-security-crypto</classpathDependencyExclude>
                <classpathDependencyExclude>org.springframework.security:spring-security-web</classpathDependencyExclude>
                <classpathDependencyExclude>org.springframework.security:spring-security-oauth2-client</classpathDependencyExclude>
                <classpathDependencyExclude>org.springframework.security:spring-security-oauth2-core</classpathDependencyExclude>
                <classpathDependencyExclude>org.springframework.security:spring-security-oauth2-jose</classpathDependencyExclude>
                <classpathDependencyExclude>org.springframework.security:spring-security-test</classpathDependencyExclude>
              </classpathDependencyExcludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <!-- Implementation-Version: the version ComponentMetadata writes into the web-types -->
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn test -Pperformance: runs only RenderPerformanceTest -->
      <id>performance</id>
      <properties>
        <shadleaf.test.groups>performance</shadleaf.test.groups>
        <shadleaf.test.excluded-groups>without-spring-security</shadleaf.test.excluded-groups>
      </properties>
    </profile>
  </profiles>
</project>
