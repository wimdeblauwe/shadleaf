<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.wimdeblauwe</groupId>
  <artifactId>shadleaf-parent</artifactId>
  <version>0.7.0</version>
  <packaging>pom</packaging>
  <name>Shadleaf</name>
  <description>shadcn/ui for Thymeleaf, packaged as a Spring Boot starter.</description>
  <url>https://github.com/wimdeblauwe/shadleaf</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>wimdeblauwe</id>
      <name>Wim Deblauwe</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/wimdeblauwe/shadleaf.git</connection>
    <developerConnection>scm:git:git@github.com:wimdeblauwe/shadleaf.git</developerConnection>
    <url>https://github.com/wimdeblauwe/shadleaf</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>shadleaf-spring-boot-starter</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>17</java.version>

    <!-- Dependencies -->
    <spring-boot.version>4.1.0</spring-boot.version>
    <jsoup.version>1.22.2</jsoup.version>

    <!-- Maven plugins -->
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <frontend-maven-plugin.version>2.0.1</frontend-maven-plugin.version>
    <frontend-maven-plugin.nodeVersion>v24.18.0</frontend-maven-plugin.nodeVersion>
    <frontend-maven-plugin.pnpmVersion>12.6.0</frontend-maven-plugin.pnpmVersion>
    <versions-maven-plugin.version>2.22.0</versions-maven-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
    <jreleaser-maven-plugin.version>1.26.0</jreleaser-maven-plugin.version>

    <!-- The release workflow tags the release commit itself, before the build; JReleaser only creates the tag of the
         snapshot pre-release (e.g. 0.3.0-SNAPSHOT), which it moves to every new commit on main. -->
    <shadleaf.release.skip-tag>false</shadleaf.release.skip-tag>
    <!-- The tag the release notes start from. Set by the release workflow to the last real release: JReleaser's own
         choice is the nearest earlier tag, which is the snapshot pre-release's tag on the commit before the release. -->
    <shadleaf.release.previous-tag/>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jsoup</groupId>
        <artifactId>jsoup</artifactId>
        <version>${jsoup.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <redirectTestOutputToFile>true</redirectTestOutputToFile>
            <printSummary>true</printSummary>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- GitHub releases with release notes from the conventional commits. Only runs on the parent (not inherited):
           mvn -N jreleaser:release. A SNAPSHOT version gives a pre-release tagged with that version, recreated on every
           push to main with everything since the last release. Maven Central is not JReleaser's job: see the release profile. -->
      <plugin>
        <groupId>org.jreleaser</groupId>
        <artifactId>jreleaser-maven-plugin</artifactId>
        <version>${jreleaser-maven-plugin.version}</version>
        <inherited>false</inherited>
        <configuration>
          <jreleaser>
            <project>
              <name>Shadleaf</name>
              <description>shadcn/ui for Thymeleaf, packaged as a Spring Boot starter.</description>
              <license>Apache-2.0</license>
              <inceptionYear>2026</inceptionYear>
              <authors>
                <author>Wim Deblauwe</author>
              </authors>
              <links>
                <homepage>https://github.com/wimdeblauwe/shadleaf</homepage>
                <documentation>https://wimdeblauwe.github.io/shadleaf/</documentation>
              </links>
              <snapshot>
                <pattern>.*-SNAPSHOT</pattern>
                <!-- The snapshot's tag. The version, not JReleaser's default early-access: GitHub lists tags that parse
                     as versions first, so the pre-release sits above the last release. Old ones are deleted by hand. -->
                <label>{{projectVersion}}</label>
                <!-- Everything since the last release, not since the previous snapshot -->
                <fullChangelog>true</fullChangelog>
              </snapshot>
            </project>
            <release>
              <github>
                <owner>wimdeblauwe</owner>
                <name>shadleaf</name>
                <tagName>{{projectVersion}}</tagName>
                <previousTagName>${shadleaf.release.previous-tag}</previousTagName>
                <!-- The pom's version, for a release and a snapshot alike -->
                <releaseName>{{projectVersion}}</releaseName>
                <skipTag>${shadleaf.release.skip-tag}</skipTag>
                <overwrite>false</overwrite>
                <prerelease>
                  <pattern>.*-(SNAPSHOT|RC\d*|M\d+)</pattern>
                </prerelease>
                <changelog>
                  <formatted>ALWAYS</formatted>
                  <preset>conventional-commits</preset>
                  <skipMergeCommits>true</skipMergeCommits>
                  <!-- The version commits of the release workflow -->
                  <labelers>
                    <labeler>
                      <label>release</label>
                      <title>regex:^chore\(release\):\s.*</title>
                    </labeler>
                  </labelers>
                  <excludeLabels>
                    <excludeLabel>release</excludeLabel>
                  </excludeLabels>
                  <hide>
                    <contributors>
                      <contributor>[bot]</contributor>
                      <contributor>GitHub</contributor>
                    </contributors>
                  </hide>
                </changelog>
              </github>
            </release>
          </jreleaser>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Maven Central: mvn -Prelease deploy. Sources, javadoc and signatures for every published module; the
         central-publishing plugin replaces the deploy plugin, uploads the bundle and waits until it is published.
         Signing uses the Bouncy Castle signer: key and passphrase come from MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE,
         no gpg executable or keyring needed. The credentials are the `central` server in settings.xml. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <configuration>
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <deploymentName>Shadleaf ${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
